+/* ---- debug hooks (ROM analysis) ---- */
+struct DbgEntry { uint8 type; uint8 val; uint16 pad; uint32 addr; uint32 pc; uint16 a, x, y, s, d; uint8 db, p; uint32 n; };
+#define DBG_LOG_SIZE (1 << 18)
+#define DBG_MAX_RANGES 16
+static DbgEntry dbg_log[DBG_LOG_SIZE];
+static uint32 dbg_head = 0, dbg_total = 0, dbg_seq = 0;
+
+#define DBG_MAX_POKES 16
+#define DBG_POKE_BYTES 8192
+static uint32 dbg_poke_pc[DBG_MAX_POKES], dbg_poke_off[DBG_MAX_POKES], dbg_poke_len[DBG_MAX_POKES];
+static uint8  dbg_poke_data[DBG_MAX_POKES][DBG_POKE_BYTES];
+static int    dbg_poke_n = 0;
+static uint8 *dbg_exec_map = NULL;                 /* bitmap over canonical 24-bit addresses */
+static uint32 dbg_rd_lo[DBG_MAX_RANGES], dbg_rd_hi[DBG_MAX_RANGES];
+static uint32 dbg_wr_lo[DBG_MAX_RANGES], dbg_wr_hi[DBG_MAX_RANGES];
+static uint32 dbg_cur_pc = 0;
+extern "C" { int dbg_any = 0, dbg_rd_n = 0, dbg_wr_n = 0; }
+
+/* Canonical form: ROM at C0-FF (HiROM), RAM at 7E/7F. */
+static inline uint32 dbg_canon(uint32 a)
+{
+	a &= 0xFFFFFF;
+	uint32 bank = a >> 16, off = a & 0xFFFF;
+	if ((bank < 0x40 || (bank >= 0x80 && bank < 0xC0)) && off < 0x2000)
+		return 0x7E0000 | off;
+	if ((bank < 0x40 || (bank >= 0x80 && bank < 0xC0)) && off >= 0x2000 && off < 0x8000)
+		return off;                       /* PPU/CPU registers mirrored in every low bank */
+	if (bank < 0x40 && off >= 0x8000)  return ((bank + 0xC0) << 16) | off;
+	if (bank >= 0x80 && bank < 0xC0 && off >= 0x8000) return ((bank + 0x40) << 16) | off;
+	return a;
+}
+
+static inline void dbg_push(uint8 type, uint32 addr, uint8 val)
+{
+	DbgEntry &e = dbg_log[dbg_head];
+	e.type = type; e.val = val; e.pad = 0; e.addr = addr; e.pc = dbg_cur_pc;
+	e.a = Registers.A.W; e.x = Registers.X.W; e.y = Registers.Y.W; e.s = Registers.S.W; e.d = Registers.D.W;
+	e.db = Registers.DB; e.p = Registers.PL; e.n = dbg_seq++;
+	dbg_head = (dbg_head + 1) & (DBG_LOG_SIZE - 1);
+	dbg_total++;
+}
+
+extern "C" {
+void dbg_pre_instr(void)
+{
+	dbg_cur_pc = Registers.PBPC;
+	if (dbg_poke_n)
+	{
+		uint32 pc = dbg_canon(Registers.PBPC);
+		for (int i = 0; i < dbg_poke_n; i++)
+			if (pc == dbg_poke_pc[i])
+				memcpy(Memory.RAM + dbg_poke_off[i], dbg_poke_data[i], dbg_poke_len[i]);
+	}
+	if (dbg_exec_map)
+	{
+		uint32 c = dbg_canon(Registers.PBPC);
+		if (dbg_exec_map[c >> 3] & (1 << (c & 7)))
+			dbg_push('X', c, 0);
+	}
+}
+void dbg_check_read(uint32 addr)
+{
+	uint32 c = dbg_canon(addr);
+	for (int i = 0; i < dbg_rd_n; i++)
+		if (c >= dbg_rd_lo[i] && c <= dbg_rd_hi[i]) { dbg_push('R', c, 0); return; }
+}
+void dbg_check_write(uint32 addr, uint8 val)
+{
+	uint32 c = dbg_canon(addr);
+	for (int i = 0; i < dbg_wr_n; i++)
+		if (c >= dbg_wr_lo[i] && c <= dbg_wr_hi[i]) { dbg_push('W', c, val); return; }
+}
+/* ---- exported API (see tools/dbg_core.py) ---- */
+void dbg_reset(void)
+{
+	dbg_any = 0; dbg_rd_n = 0; dbg_wr_n = 0; dbg_poke_n = 0; dbg_head = 0; dbg_total = 0; dbg_seq = 0;
+	if (dbg_exec_map) memset(dbg_exec_map, 0, 1 << 21);
+}
+void dbg_add_exec(uint32 addr)
+{
+	if (!dbg_exec_map) { dbg_exec_map = (uint8 *) calloc(1 << 21, 1); }
+	uint32 c = dbg_canon(addr);
+	dbg_exec_map[c >> 3] |= (1 << (c & 7));
+	dbg_any = 1;
+}
+void dbg_add_read(uint32 lo, uint32 hi)
+{
+	if (dbg_rd_n < DBG_MAX_RANGES) { dbg_rd_lo[dbg_rd_n] = dbg_canon(lo); dbg_rd_hi[dbg_rd_n] = dbg_canon(hi); dbg_rd_n++; dbg_any = 1; }
+}
+void dbg_add_write(uint32 lo, uint32 hi)
+{
+	if (dbg_wr_n < DBG_MAX_RANGES) { dbg_wr_lo[dbg_wr_n] = dbg_canon(lo); dbg_wr_hi[dbg_wr_n] = dbg_canon(hi); dbg_wr_n++; dbg_any = 1; }
+}
+
+/* When the instruction at exec_addr is about to run, copy len bytes into work RAM at wram_off (0..0x1FFFF). */
+int dbg_add_poke(uint32 exec_addr, uint32 wram_off, const uint8 *data, int len)
+{
+	if (dbg_poke_n >= DBG_MAX_POKES || len > DBG_POKE_BYTES || wram_off + len > 0x20000) return -1;
+	dbg_poke_pc[dbg_poke_n] = dbg_canon(exec_addr);
+	dbg_poke_off[dbg_poke_n] = wram_off;
+	dbg_poke_len[dbg_poke_n] = len;
+	memcpy(dbg_poke_data[dbg_poke_n], data, len);
+	dbg_poke_n++; dbg_any = 1;
+	return dbg_poke_n - 1;
+}
+void dbg_clear_pokes(void) { dbg_poke_n = 0; }
+uint32 dbg_log_total(void) { return dbg_total; }
+int dbg_entry_size(void) { return (int) sizeof(DbgEntry); }
+/* Copy the most recent up to max entries (oldest first) into out and clear the log. Returns count. */
+int dbg_log_read(DbgEntry *out, int max)
+{
+	uint32 have = dbg_total < DBG_LOG_SIZE ? dbg_total : DBG_LOG_SIZE;
+	int n = (int) (have < (uint32) max ? have : (uint32) max);
+	uint32 start = (dbg_head + DBG_LOG_SIZE - n) & (DBG_LOG_SIZE - 1);
+	for (int i = 0; i < n; i++) out[i] = dbg_log[(start + i) & (DBG_LOG_SIZE - 1)];
+	dbg_head = 0; dbg_total = 0;
+	return n;
+}
+}
+/* ---- end debug hooks ---- */
